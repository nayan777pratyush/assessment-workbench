# Assessment Workbench — local / production environment
# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=3000

# Required. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# PostgreSQL connection string. Examples:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/assessment_workbench
# DATABASE_URL=postgresql://user:password@host:5432/assessment_workbench?sslmode=require
DATABASE_URL=
# Set true for managed Postgres when the provider requires TLS.
DATABASE_SSL=false
DB_POOL_MAX=10

VITE_APP_ID=assessment-workbench
# Local: http://localhost:3000
# Production: https://your-domain.com
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google — recommended primary sign-in
# Callback: http://localhost:3000/api/auth/google/callback
# Production callback: https://YOUR_DOMAIN/api/auth/google/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OIDC_ISSUER_URL=https://accounts.google.com

# -----------------------------------------------------------------------------
# GitHub — optional
# Callback: http://localhost:3000/api/auth/github/callback
# Production callback: https://YOUR_DOMAIN/api/auth/github/callback
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Microsoft Entra ID — optional
# Callback: http://localhost:3000/api/auth/microsoft/callback
# Production callback: https://YOUR_DOMAIN/api/auth/microsoft/callback
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_OIDC_ISSUER_URL=https://login.microsoftonline.com/common/v2.0

# -----------------------------------------------------------------------------
# Institution / generic OpenID Connect — optional
# Callback: http://localhost:3000/api/auth/oidc/callback
# -----------------------------------------------------------------------------
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_DOMAINS=
OIDC_DISPLAY_NAME=Institution SSO

# -----------------------------------------------------------------------------
# Email magic links via Resend — optional
# -----------------------------------------------------------------------------
EMAIL_API_KEY=
EMAIL_FROM=Assessment Workbench <no-reply@yourdomain.com>

# Optional: enables live AI guidance in Bug Hunt. Keep the key server-side only.
AI_API_KEY=
AI_MODEL=
